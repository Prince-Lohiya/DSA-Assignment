#include <stdio.h>
#include <string.h>
#include <ctype.h>
#define size 100

int queue[size];
int priority[size];
int front =  -1;
int rear = -1;

void enqueue(int value){
    if(rear == (size - 1)){
        printf("There is no bed left for new patient");
        return;
    }
    
    if(front == -1){
        front = 0;
    }
    
    rear++;
    queue[rear] = 1;
    priority[rear] = value;
}

int dequeue(){
    if(front == -1){
        printf("There is no patient in Hospital");
        return -1;
    }
    
    int pos = front;
    int i;
    
    for(i = (front + 1); i <= rear; i++){
        if(priority[i] < priority[pos]){
            pos = i;
        }
    }
    
    int x = queue[pos];
    
    for(i = pos; i < rear; i++){
        queue[i] = queue[i + 1];
        priority[i] = priority[i + 1];
    }
    
    rear--;
    if(front > rear){
        front = rear = -1;
    }
    
    return x;
}

int compare(char a[], char b[]){
    int i = 0;
    while(a[i] != '\0' && b[i] != '\0'){
        if(toupper(a[i]) != toupper(b[i])){
            return 0;
        }
        i++;
    }

    return a[i] == '\0' && b[i] == '\0';
}

void display(){
    int count[15] = {0};

    if(front == -1){
        printf("No patients in hospital\n");
        return;
    }

    for(int i = front; i <= rear; i++){
        count[priority[i]]++;
    }

    printf("\n--- Hospital Patient Report ---\n");

    printf("Cardiac Arrest       : %d\n", count[1]);
    printf("Respiratory Arrest   : %d\n", count[2]);
    printf("Severe Shock         : %d\n", count[3]);
    printf("Uncontrolled Bleeding: %d\n", count[4]);
    printf("Unconsciousness      : %d\n", count[5]);
    printf("Major Stroke         : %d\n", count[6]);
    printf("Trauma               : %d\n", count[7]);
    printf("Heart Attack         : %d\n", count[8]);
    printf("Severe Burns         : %d\n", count[9]);
    printf("Asthma Attack        : %d\n", count[10]);
    printf("Abdominal Pain       : %d\n", count[11]);
    printf("Minor Fractures      : %d\n", count[12]);
    printf("Fever                : %d\n", count[13]);
    printf("Cold                 : %d\n", count[14]);

    printf("-------------------------------\n");
    printf("Total Patients       : %d\n", rear - front + 1);
}

int main() {
    int choice, p;
    char disease[50];
    
    char diseases[14][30] = {"Cardiac arrest", "Respiratory arrest", "Severe shock", "uncontrolled bleeding", "unconsciousness", "major stroke", "trauma", "heart attack", "Severe burns", "asthma attack", "abdominal pain", "Minor fractures", "fever", "cold"};

    while(1){
        printf("\n--- Hospital Patient Management ---\n");
        printf("1. Add Patient\n");
        printf("2. Treat Patient\n");
        printf("3. Display Patients\n");
        printf("4. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice){

            case 1:
                printf("\nAvailable Diseases:\n");

                for(int i = 0; i < 14; i++){
                    printf("%s\n", diseases[i]);
                }
                
                printf("Enter disease name: ");
                scanf(" %49[^\n]", disease);

                p = -1;

                for(int i = 0; i < 14; i++){
                    if(compare(disease, diseases[i])){
                        p = i + 1;
                        break;
                    }
                }
                
                enqueue(p);
                printf("Patient added with priority %d\n", p);
                break;

            case 2:
                p = dequeue();

                if(p != -1){
                    printf("Patient with priority %d is being treated\n", diseases[p]);
                }
                break;

            case 3:
                display();
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
