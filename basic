#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifdef _WIN32
#include <windows.h>
static void enableAnsi(void) {
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD mode;
    if (GetConsoleMode(h, &mode))
        SetConsoleMode(h, mode | 0x0004);  // ENABLE_VIRTUAL_TERMINAL_PROCESSING
}
#else
static void enableAnsi(void) {}
#endif

#define MAX 100
#define NAME_LEN 50

#define RED   "\033[1;31m"
#define TEAL  "\033[36m"
#define GREY  "\033[90m"
#define RESET "\033[0m"

typedef struct {
    int id;
    char name[NAME_LEN];
    int age;
    int priority;
    int seq;
} Patient;

typedef struct {
    Patient data[MAX];
    int size;
} Heap;

static int arrivalCounter = 0;

static const char *levelName[] = {
    "", "Critical", "Emergency", "Urgent", "Less Urgent", "Non-Urgent"
};

int isLess(Patient a, Patient b) {
    if (a.priority != b.priority)
        return a.priority < b.priority;
    return a.seq < b.seq;
}

void swapPatients(Patient *a, Patient *b) {
    Patient t = *a;
    *a = *b;
    *b = t;
}

int isEmpty(Heap *h) {
    return h->size == 0;
}

int isFull(Heap *h) {
    return h->size == MAX;
}

void heapifyUp(Heap *h, int i) {
    while (i > 0) {
        int p = (i - 1) / 2;
        if (isLess(h->data[i], h->data[p])) {
            swapPatients(&h->data[i], &h->data[p]);
            i = p;
        } else {
            break;
        }
    }
}

void heapifyDown(Heap *h, int i) {
    while (1) {
        int l = 2 * i + 1;
        int r = 2 * i + 2;
        int s = i;
        if (l < h->size && isLess(h->data[l], h->data[s]))
            s = l;
        if (r < h->size && isLess(h->data[r], h->data[s]))
            s = r;
        if (s == i)
            break;
        swapPatients(&h->data[i], &h->data[s]);
        i = s;
    }
}

int findIndex(Heap *h, int id) {
    for (int i = 0; i < h->size; i++)
        if (h->data[i].id == id)
            return i;
    return -1;
}

int insertPatient(Heap *h, Patient p) {
    if (isFull(h))
        return 0;
    p.seq = arrivalCounter++;
    h->data[h->size] = p;
    heapifyUp(h, h->size);
    h->size++;
    return 1;
}

int extractMin(Heap *h, Patient *out) {
    if (isEmpty(h))
        return 0;
    *out = h->data[0];
    h->size--;
    if (h->size > 0) {
        h->data[0] = h->data[h->size];
        heapifyDown(h, 0);
    }
    return 1;
}

int peekMin(Heap *h, Patient *out) {
    if (isEmpty(h))
        return 0;
    *out = h->data[0];
    return 1;
}

int removeAt(Heap *h, int i) {
    if (i < 0 || i >= h->size)
        return 0;
    h->size--;
    if (i != h->size) {
        h->data[i] = h->data[h->size];
        heapifyUp(h, i);
        heapifyDown(h, i);
    }
    return 1;
}

int updatePriority(Heap *h, int id, int newPriority) {
    int i = findIndex(h, id);
    if (i == -1)
        return 0;
    h->data[i].priority = newPriority;
    heapifyUp(h, i);
    i = findIndex(h, id);
    heapifyDown(h, i);
    return 1;
}

int readLine(char *buf, int size) {
    if (fgets(buf, size, stdin) == NULL)
        return 0;
    size_t len = strlen(buf);
    if (len > 0 && buf[len - 1] == '\n') {
        buf[len - 1] = '\0';
    } else {
        int c;
        while ((c = getchar()) != '\n' && c != EOF)
            ;
    }
    return 1;
}

int readInt(const char *prompt, int lo, int hi) {
    char buf[64];
    char *end;
    while (1) {
        printf(TEAL "%s" RESET, prompt);
        if (!readLine(buf, sizeof(buf)))
            exit(0);
        long v = strtol(buf, &end, 10);
        if (end == buf || *end != '\0') {
            printf("Invalid input. Enter a number.\n");
            continue;
        }
        if (v < lo || v > hi) {
            printf("Value must be between %d and %d.\n", lo, hi);
            continue;
        }
        return (int)v;
    }
}

void readName(char *name) {
    while (1) {
        printf(TEAL "Enter patient name: " RESET);
        if (!readLine(name, NAME_LEN))
            exit(0);
        int blank = 1;
        for (int i = 0; name[i]; i++)
            if (name[i] != ' ' && name[i] != '\t')
                blank = 0;
        if (blank) {
            printf("Name cannot be empty.\n");
            continue;
        }
        return;
    }
}

void printPriorityGuide(void) {
    printf("  1 - Critical (immediate)\n");
    printf("  2 - Emergency\n");
    printf("  3 - Urgent\n");
    printf("  4 - Less Urgent\n");
    printf("  5 - Non-Urgent\n");
}

void printHeader(void) {
    printf("%-6s %-22s %-5s %-12s %-8s\n", "ID", "Name", "Age", "Priority", "Arrival");
    printf("------------------------------------------------------------\n");
}

void printPatient(Patient p) {
    printf("%-6d %-22s %-5d %-12s #%-7d\n",
           p.id, p.name, p.age, levelName[p.priority], p.seq + 1);
}

void addPatient(Heap *h) {
    if (isFull(h)) {
        printf("Emergency room is full. Cannot admit more patients.\n");
        return;
    }
    Patient p;
    p.id = readInt("Enter patient ID (1-99999): ", 1, 99999);
    if (findIndex(h, p.id) != -1) {
        printf("A patient with ID %d is already in the queue.\n", p.id);
        return;
    }
    readName(p.name);
    p.age = readInt("Enter age (0-120): ", 0, 120);
    printPriorityGuide();
    p.priority = readInt("Enter priority (1-5): ", 1, 5);
    insertPatient(h, p);
    printf("Patient %s admitted with priority: %s.\n", p.name, levelName[p.priority]);
}

void treatNext(Heap *h) {
    Patient p;
    if (!extractMin(h, &p)) {
        printf("No patients waiting.\n");
        return;
    }
    printf("Now treating:\n");
    printHeader();
    printPatient(p);
}

void viewNext(Heap *h) {
    Patient p;
    if (!peekMin(h, &p)) {
        printf("No patients waiting.\n");
        return;
    }
    printf("Next patient to be treated:\n");
    printHeader();
    printPatient(p);
}

void searchPatient(Heap *h) {
    if (isEmpty(h)) {
        printf("No patients waiting.\n");
        return;
    }
    int id = readInt("Enter patient ID to search: ", 1, 99999);
    int i = findIndex(h, id);
    if (i == -1) {
        printf("Patient with ID %d not found.\n", id);
        return;
    }
    printHeader();
    printPatient(h->data[i]);
}

void changePriority(Heap *h) {
    if (isEmpty(h)) {
        printf("No patients waiting.\n");
        return;
    }
    int id = readInt("Enter patient ID: ", 1, 99999);
    if (findIndex(h, id) == -1) {
        printf("Patient with ID %d not found.\n", id);
        return;
    }
    printPriorityGuide();
    int np = readInt("Enter new priority (1-5): ", 1, 5);
    updatePriority(h, id, np);
    printf("Priority updated to %s.\n", levelName[np]);
}

void dischargePatient(Heap *h) {
    if (isEmpty(h)) {
        printf("No patients waiting.\n");
        return;
    }
    int id = readInt("Enter patient ID to remove: ", 1, 99999);
    int i = findIndex(h, id);
    if (i == -1) {
        printf("Patient with ID %d not found.\n", id);
        return;
    }
    printf("Patient %s removed from the queue.\n", h->data[i].name);
    removeAt(h, i);
}

void displayQueue(Heap *h) {
    if (isEmpty(h)) {
        printf("No patients waiting.\n");
        return;
    }
    Heap copy = *h;
    Patient p;
    printf("Patients in treatment order (%d waiting):\n", h->size);
    printHeader();
    while (extractMin(&copy, &p))
        printPatient(p);
}

void displayHeapArray(Heap *h) {
    if (isEmpty(h)) {
        printf("Heap is empty.\n");
        return;
    }
    printf("Heap array (index: id/priority):\n");
    for (int i = 0; i < h->size; i++)
        printf("[%d] %d/P%d  ", i, h->data[i].id, h->data[i].priority);
    printf("\n");
}

void printMenu(void) {
    printf("\n" RED "+ HOSPITAL EMERGENCY TRIAGE +" RESET "\n\n");
    printf("1. Admit new patient\n");
    printf("2. Treat next patient\n");
    printf("3. View next patient\n");
    printf("4. Search patient by ID\n");
    printf("5. Change patient priority\n");
    printf("6. Remove patient from queue\n");
    printf("7. Display all waiting patients\n");
    printf("8. Display heap array\n");
    printf("9. Exit\n");
}

void waitForEnter(void) {
    char buf[64];
    printf("\n" GREY "Press Enter to continue..." RESET);
    readLine(buf, sizeof(buf));
}

int main(void) {
    enableAnsi();
    Heap h;
    h.size = 0;
    int choice;
    do {
        printMenu();
        choice = readInt("Enter choice: ", 1, 9);
        printf("\n");
        switch (choice) {
            case 1: addPatient(&h); break;
            case 2: treatNext(&h); break;
            case 3: viewNext(&h); break;
            case 4: searchPatient(&h); break;
            case 5: changePriority(&h); break;
            case 6: dischargePatient(&h); break;
            case 7: displayQueue(&h); break;
            case 8: displayHeapArray(&h); break;
            case 9: printf("Exiting. Stay safe.\n"); break;
        }
        if (choice != 9)
            waitForEnter();
    } while (choice != 9);
    return 0;
}